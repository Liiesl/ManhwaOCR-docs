---
import { getNavLinks } from '../lib/navigation.ts';
import NavList from './NavList.astro';
import SearchWrapper from './SearchWrapper.astro';

const navGroups = await getNavLinks();
---
<SearchWrapper />

<nav class="sidebar-nav">
    {navGroups.map(group => (
      <div class="nav-group">
        <h3 class="nav-group-title">{group.title}</h3>
        <NavList items={group.pages} />
      </div>
    ))}
</nav>

<div class="sidebar-footer">
    <a href="https://github.com/Liiesl/EasyScanlate" target="_blank" rel="noopener noreferrer" class="footer-link">
        <svg class="footer-icon" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
