---
// your-new-docs-site/src/layouts/BaseLayout.astro

import LeftSidebar from '../components/LeftSidebar.astro';
import TableOfContents from '../components/TableOfContents.tsx';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EditPageLink from '../components/EditPageLink.astro';
import PageNavigation from '../components/PageNavigation.astro';

// 'headings' is automatically provided by Astro from the markdown content
const { frontmatter, headings } = Astro.props;
const { title, description } = frontmatter;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{title} | Easy Scanlate Docs</title>
    <meta name="description" content={description || 'Official documentation for Easy Scanlate.'}>

    <link rel="stylesheet" href="/assets/style.css">
    <!-- 
        REMOVED: The Highlight.js CDN link.
        Astro's built-in Shiki handles syntax highlighting and injects the necessary styles.
    -->
</head>
<body>
    <div class="container">
        
        <aside class="sidebar">
            <h1 class="site-title"><a href="/">Easy Scanlate</a></h1>
            <LeftSidebar />
        </aside>

        <main id="content">
            <!-- Breadcrumbs and Edit link row -->
            <div class="content-header">
                <Breadcrumbs />
                <EditPageLink />
            </div>

            <!-- The content of your markdown files goes here -->
            <slot />

            <!-- Previous/Next page navigation -->
            <PageNavigation />
        </main>

        <aside class="toc-sidebar">
            <!--
                Interactive Table of Contents with scroll spy highlighting.
                Uses client:idle to hydrate after initial page load.
            -->
            <TableOfContents headings={headings} client:idle />
        </aside>

    </div>
    <!--
        Table of Contents is now interactive with scroll spy.
        No additional scripts needed - handled by Preact component hydration.
    -->
</body>
</html>